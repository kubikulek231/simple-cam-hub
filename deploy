#!/bin/bash
# simple-cctv-hub deployment script

# --- colors & log helpers ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info()  { echo -e "[INFO]  $1"; }
log_warn()  { echo -e "${YELLOW}[WARN]  $1${NC}"; }
log_error() { echo -e "${RED}[ERROR] $1${NC}"; }
log_ok()    { echo -e "${GREEN}[OK]    $1${NC}"; }
# -----------------------------

LOCAL_DIR=~/simple-cctv-hub/www
TARGET_DIR=/var/www/html

DEVELOPMENT_USER=kubikulek231
PUBLISH_USER=raspberrypi5

CCTV_FOOTAGE_DIR=~/footage
CCTV_FOOTAGE_CAMS=(cam1 cam2 cam3)
CCTV_FOOTAGE_DOWNLOAD_URL="https://test-videos.co.uk/vids/bigbuckbunny/mp4/h265/1080/Big_Buck_Bunny_1080_10s_10MB.mp4"
CCTV_WWW_DIR=/var/www/html/footage
CCTV_SEED_FOOTAGE_SCRIPT=~/simple-cctv-hub/deploy_scripts/seed_footage

NGINX_TEMPLATE_PATH=~/simple-cctv-hub/nginx.conf.template
NGINX_TEMPLATE_TARGET_USER_KEYWORD=PLACEHOLDER_USER
NGINX_DEFAULT_CONF_PATH=/etc/nginx/nginx.conf

SERVICE_CC_CAM1_PATH=~/simple-cctv-hub/cam_capture/cc_cam1.service
SERVICE_CC_CAM2_PATH=~/simple-cctv-hub/cam_capture/cc_cam2.service
SERVICE_CC_CAM3_PATH=~/simple-cctv-hub/cam_capture/cc_cam3.service
SERVICE_F_CLEANUP_PATH=~/simple-cctv-hub/footage_cleanup/f_cleanup.service

SERVICE_SCRIPT_CC_CAM1_PATH=~/simple-cctv-hub/cam_capture/cc_cam1.sh
SERVICE_SCRIPT_CC_CAM2_PATH=~/simple-cctv-hub/cam_capture/cc_cam2.sh
SERVICE_SCRIPT_CC_CAM3_PATH=~/simple-cctv-hub/cam_capture/cc_cam3.sh
SERVICE_SCRIPT_F_CLEANUP_PATH=~/simple-cctv-hub/footage_cleanup/f_cleanup.sh

SERVICE_FI_FETCH_CAM1_PATH=~/simple-cctv-hub/footage_info_fetch/fi_fetch_cam1.service
SERVICE_FI_FETCH_CAM2_PATH=~/simple-cctv-hub/footage_info_fetch/fi_fetch_cam2.service
SERVICE_FI_FETCH_CAM3_PATH=~/simple-cctv-hub/footage_info_fetch/fi_fetch_cam3.service

SERVICE_SCRIPT_FI_FETCH_CAM1_PATH=~/simple-cctv-hub/footage_info_fetch/fi_fetch_cam1.sh
SERVICE_SCRIPT_FI_FETCH_CAM2_PATH=~/simple-cctv-hub/footage_info_fetch/fi_fetch_cam2.sh
SERVICE_SCRIPT_FI_FETCH_CAM3_PATH=~/simple-cctv-hub/footage_info_fetch/fi_fetch_cam3.sh

DEVELOPMENT=1
if [ "$USER" = "$PUBLISH_USER" ]; then
    DEVELOPMENT=0
fi

declare -A SERVICES=(
    ["cc_cam1.service"]="$SERVICE_CC_CAM1_PATH"
    ["cc_cam2.service"]="$SERVICE_CC_CAM2_PATH"
    ["cc_cam3.service"]="$SERVICE_CC_CAM3_PATH"
    ["f_cleanup.service"]="$SERVICE_F_CLEANUP_PATH"
    ["fi_fetch_cam1.service"]="$SERVICE_FI_FETCH_CAM1_PATH"
    ["fi_fetch_cam2.service"]="$SERVICE_FI_FETCH_CAM2_PATH"
    ["fi_fetch_cam3.service"]="$SERVICE_FI_FETCH_CAM3_PATH"
)

declare -A SERVICE_SCRIPTS=(
    ["cc_cam1.service"]="$SERVICE_SCRIPT_CC_CAM1_PATH"
    ["cc_cam2.service"]="$SERVICE_SCRIPT_CC_CAM2_PATH"
    ["cc_cam3.service"]="$SERVICE_SCRIPT_CC_CAM3_PATH"
    ["f_cleanup.service"]="$SERVICE_SCRIPT_F_CLEANUP_PATH"
    ["fi_fetch_cam1.service"]="$SERVICE_SCRIPT_FI_FETCH_CAM1_PATH"
    ["fi_fetch_cam2.service"]="$SERVICE_SCRIPT_FI_FETCH_CAM2_PATH"
    ["fi_fetch_cam3.service"]="$SERVICE_SCRIPT_FI_FETCH_CAM3_PATH"
)

FORCE=0
for arg in "$@"; do
    if [[ "$arg" == "--force" || "$arg" == "-f" ]]; then
        FORCE=1
    fi
done

check_and_save_if_changed() {
    local src_file=$1
    local dst_file=$2

    if [ "$FORCE" -eq 1 ]; then
        log_info "Force mode: redeploying $dst_file."
        return 0
    fi

    if ! sudo diff -q "$src_file" "$dst_file" > /dev/null 2>&1; then
        log_info "Change detected for $dst_file."
        return 0
    else
        log_info "$dst_file is up to date, no changes needed."
        return 1
    fi
}

update_service() {
    local service_name=$1
    local service_script_path=$2
    local local_service_file=$3
    local system_service_file="/etc/systemd/system/$service_name"
    local tmp_service_file="/tmp/$service_name"

    local script_changed=1
    local service_changed=1

    if [ -f "$service_script_path" ]; then
        local system_script_path="/usr/local/bin/$(basename "$service_script_path")"
        if check_and_save_if_changed "$service_script_path" "$system_script_path"; then
            script_changed=0
            sudo cp "$service_script_path" "$system_script_path"
            sudo chmod +x "$system_script_path"
            sudo dos2unix "$system_script_path"
        fi
    fi

    if check_and_save_if_changed "$local_service_file" "$system_service_file"; then
        service_changed=0
        cp "$local_service_file" "$tmp_service_file"
        sudo dos2unix "$tmp_service_file"
        sudo cp "$tmp_service_file" "$system_service_file"
    fi

    if [ $script_changed -eq 0 ] || [ $service_changed -eq 0 ]; then
        log_info "Reloading and restarting $service_name ..."
        sudo systemctl daemon-reload
        if sudo systemctl restart "$service_name"; then
            sudo systemctl enable "$service_name"
            log_ok "Service $service_name restarted and enabled."
        else
            log_error "Failed to restart $service_name."
        fi
    else
        log_info "No changes for $service_name or its script. Skipping update."
    fi
}

if [ "$DEVELOPMENT" -eq 0 ]; then
    for svc_name in "${!SERVICES[@]}"; do
        update_service "$svc_name" "${SERVICE_SCRIPTS[$svc_name]}" "${SERVICES[$svc_name]}"
    done
else
    log_info "Development mode enabled (DEVELOPMENT=$DEVELOPMENT). Skipping service deployment."
fi

log_info "Cleaning $TARGET_DIR except cam* directories ..."
shopt -s extglob
sudo rm -rf $TARGET_DIR/!(cam*)

log_info "Converting $LOCAL_DIR files using dos2unix ..."
find "$LOCAL_DIR" -type f -exec sudo dos2unix -q {} +
log_info "Copying files from $LOCAL_DIR to $TARGET_DIR ..."
sudo cp -rf $LOCAL_DIR/* $TARGET_DIR/

log_info "Setting permissions for $TARGET_DIR ..."
sudo chown -R $USER:www-data $TARGET_DIR
sudo chmod -R 755 $TARGET_DIR

log_info "Creating symbolic link to the CCTV footage directory ..."
sudo ln -s $CCTV_FOOTAGE_DIR $CCTV_WWW_DIR 2>/dev/null || true

log_info "Create www-data group and add www-data user to it ..."
sudo groupadd www-data 2>/dev/null || true
sudo usermod -aG www-data www-data

NGINX_TMP_CUSTOM_CONF_PATH="/tmp/custom_nginx.conf"
NGINX_TMP_NEW_CONF_PATH="/tmp/nginx.conf.new"

log_info "Checking for NGINX configuration changes ..."
sed "s/${NGINX_TEMPLATE_TARGET_USER_KEYWORD}/$USER/g" "$NGINX_TEMPLATE_PATH" \
  | sudo tee "$NGINX_TMP_CUSTOM_CONF_PATH" > /dev/null
sudo dos2unix "$NGINX_TMP_CUSTOM_CONF_PATH"

if check_and_save_if_changed "$NGINX_TMP_CUSTOM_CONF_PATH" "$NGINX_DEFAULT_CONF_PATH"; then
    sudo cp "$NGINX_TMP_CUSTOM_CONF_PATH" "$NGINX_DEFAULT_CONF_PATH"
    log_info "Checking the new conf file ..."
    if sudo nginx -t; then
        log_ok "Configuration test passed. Restarting NGINX ..."
        if sudo systemctl restart nginx; then
            log_ok "NGINX successfully restarted."
        else
            log_error "Failed to restart NGINX. Please check the logs."
        fi
    else
        log_error "NGINX configuration test failed. Please check your configuration."
        exit 1
    fi
else
    log_info "NGINX configuration is up to date, no changes needed."
fi

if [ ! -d "$CCTV_FOOTAGE_DIR" ]; then
    log_info "Creating CCTV footage directory at $CCTV_FOOTAGE_DIR ..."
    mkdir -p "$CCTV_FOOTAGE_DIR"
else
    log_info "Footage directory already exists, skipping creation."
fi

if [ ! -d "$CCTV_FOOTAGE_DIR/${CCTV_FOOTAGE_CAMS[0]}" ]; then
    sudo dos2unix "$CCTV_SEED_FOOTAGE_SCRIPT"
    log_info "Seeding CCTV footage directory with sample files ..."
    "$CCTV_SEED_FOOTAGE_SCRIPT"
else
    log_info "CCTV footage directory already seeded, skipping."
fi

log_info "Setting permissions for $CCTV_WWW_DIR ..."
sudo chown -R $USER:www-data $CCTV_WWW_DIR
sudo chmod -R 755 $CCTV_WWW_DIR

log_info "Setting permissions for $CCTV_FOOTAGE_DIR ..."
sudo chown -R $USER:www-data $CCTV_FOOTAGE_DIR
sudo chmod -R 755 $CCTV_FOOTAGE_DIR

log_ok "Deployment complete!"
