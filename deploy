#!/bin/bash
LOCAL_DIR=~/simple-cam-hub/www         # Path to your local directory
TARGET_DIR=/var/www/html               # Target directory on the server

DEVELOPMENT_USER=kubikulek231          # Development user
PUBLISH_USER=raspberrypi5			   # Publish/target user

CCTV_FOOTAGE_DIR=~/footage
CCTV_FOOTAGE_CAMS=(cam1 cam2 cam3)
CCTV_FOOTAGE_DOWNLOAD_URL="https://test-videos.co.uk/vids/bigbuckbunny/mp4/h265/1080/Big_Buck_Bunny_1080_10s_10MB.mp4"
CCTV_WWW_DIR=/var/www/html/footage
CCTV_SEED_FOOTAGE_SCRIPT=~/simple-cam-hub/deploy_scripts/seed_footage

NGINX_TEMPLATE_PATH=~/simple-cam-hub/nginx.conf.template
NGINX_TEMPLATE_TARGET_USER_KEYWORD=PLACEHOLDER_USER
NGINX_DEFAULT_CONF_PATH=/etc/nginx/nginx.conf

SERVICE_CC_CAM1_PATH=~/simple-cam-hub/cam_capture/cc_cam1.service
SERVICE_CC_CAM2_PATH=~/simple-cam-hub/cam_capture/cc_cam2.service
SERVICE_CC_CAM3_PATH=~/simple-cam-hub/cam_capture/cc_cam3.service
SERVICE_F_CLEANUP_PATH=~/simple-cam-hub/footage_cleanup/f_cleanup.service

# Determine if running as publish user or development user
DEVELOPMENT=1
if [ "$USER" = "$PUBLISH_USER" ]; then
    DEVELOPMENT=0
fi

# List of service files and their target names (extract filename only for systemctl)
declare -A SERVICES=(
    ["cc_cam1.service"]="$SERVICE_CC_CAM1_PATH"
    ["cc_cam2.service"]="$SERVICE_CC_CAM2_PATH"
    ["cc_cam3.service"]="$SERVICE_CC_CAM3_PATH"
    ["f_cleanup.service"]="$SERVICE_F_CLEANUP_PATH"
)

# Function to update systemd service files, reload and restart
update_service() {
    local service_name=$1
    local local_service_file=$2
    local system_service_file="/etc/systemd/system/$service_name"

    echo "Updating systemd service: $service_name ..."
    sudo cp "$local_service_file" "$system_service_file"
    sudo systemctl daemon-reload
    sudo systemctl restart "$service_name"
    sudo systemctl enable "$service_name"
}

if [ "$DEVELOPMENT" -eq 0 ]; then
    # Production: update all services
    for svc_name in "${!SERVICES[@]}"; do
        update_service "$svc_name" "${SERVICES[$svc_name]}"
    done
else
    echo "Development mode enabled (DEVELOPMENT=$DEVELOPMENT). Skipping service deployment."
fi
# Remove the target directory
echo "Removing $TARGET_DIR ..."
sudo rm -rf $TARGET_DIR

# Create a new target directory
echo "Creating $TARGET_DIR ..."
sudo mkdir -p $TARGET_DIR

# Copy local directory to target directory
echo "Copying files from $LOCAL_DIR to $TARGET_DIR ..."
sudo cp -rf $LOCAL_DIR/* $TARGET_DIR/

# Set ownership to www-data for the web root directory
echo "Setting permissions for $TARGET_DIR ..."
sudo chown -R $USER:www-data $TARGET_DIR  # Set group to www-data
sudo chmod -R 755 $TARGET_DIR

# Create symbolic link to the footage directory
echo "Creating symbolic link to the CCTV footage directory ..."
sudo ln -s $CCTV_FOOTAGE_DIR $CCTV_WWW_DIR

echo "Create www-data group and add www-data user to it ..."
sudo groupadd www-data || true
sudo usermod -aG www-data www-data

NGINX_TMP_CUSTOM_CONF_PATH="/tmp/custom_nginx.conf"

# Set the new nginx conf
echo "Checking for NGINX configuration changes ..."
sed "s/${NGINX_TEMPLATE_TARGET_USER_KEYWORD}/$USER/g" "$NGINX_TEMPLATE_PATH" > "$NGINX_TMP_CUSTOM_CONF_PATH"

if ! sudo diff -q "$NGINX_TMP_CUSTOM_CONF_PATH" "$NGINX_DEFAULT_CONF_PATH" > /dev/null 2>&1; then
    echo "Updating NGINX configuration ..."
    sudo cp "$NGINX_TMP_CUSTOM_CONF_PATH" "$NGINX_DEFAULT_CONF_PATH"

    echo "Checking the new conf file ..."
    if sudo nginx -t; then
        echo "Configuration test passed. Restarting NGINX ..."
        if sudo systemctl restart nginx; then
            echo "NGINX successfully restarted."
        else
            echo "Failed to restart NGINX. Please check the logs."
        fi
    else
        echo "Error: NGINX configuration test failed. Please check your configuration."
        exit 1
    fi
else
    echo "NGINX configuration is up to date, no changes needed."
fi

# Create footage dir if it doesn't exist
if [ ! -d "$CCTV_FOOTAGE_DIR" ]; then
    echo "Creating CCTV footage directory at $CCTV_FOOTAGE_DIR ..."
    mkdir -p "$CCTV_FOOTAGE_DIR"
else
    echo "Footage directory already exists, skipping creation."
fi

# Seed the footage directory with sample video files
if [ ! -d "$CCTV_FOOTAGE_DIR/${CCTV_FOOTAGE_CAMS[0]}" ]; then
    echo "Seeding CCTV footage directory with sample files ..."
    "$CCTV_SEED_FOOTAGE_SCRIPT"
else
    echo "CCTV footage directory already seeded, skipping."
fi

# Set ownership to www-data for the footage directory
echo "Setting permissions for $CCTV_WWW_DIR ..."
sudo chown -R $USER:www-data $CCTV_WWW_DIR  # Set group to www-data
sudo chmod -R 755 $CCTV_WWW_DIR

echo "Setting permissions for $CCTV_FOOTAGE_DIR ..."
sudo chown -R $USER:www-data $CCTV_FOOTAGE_DIR  # Set group to www-data
sudo chmod -R 755 $CCTV_FOOTAGE_DIR

echo "Deployment complete!"
