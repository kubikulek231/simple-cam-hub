[unit]
Description=Camera Footage Cleanup Service
After=multi-user.target

[Service]
Type=idle
ExecStart=/home/raspberrypi5/simple-cctv-hub/footage_mgmt/f_cleanup.sh
User=raspberrypi5
Restart=always
RuntimeMaxSec=1d
RestartSec=20

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
